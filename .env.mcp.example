# Copy into the local .env.local file; never commit an actual API key.
# Built-in vibe assistant: Codex via the existing local CPA launcher.
# The launcher owns model-provider selection and credentials; no key goes here.
ZEM_VIBE_ENGINE=codex
ZEM_VIBE_CODEX_CMD=C:\path\to\cx_launcher.py
ZEM_VIBE_CODEX_PROVIDER=cpa

# Alternative: Claude Code CLI with DeepSeek as the model service.
# ZEM_VIBE_ENGINE=claude
# ZEM_VIBE_CLAUDE_BASE_URL=https://api.deepseek.com/anthropic
# ZEM_VIBE_CLAUDE_MODEL=deepseek-chat
# ZEM_VIBE_CLAUDE_AUTH_TOKEN=

# The direct DeepSeek engine also supports the same MCP tools. To use it,
# set ZEM_VIBE_ENGINE=deepseek and configure ZEM_VIBE_LLM_API_KEY instead.
# ZEM_VIBE_LLM_API_KEY=

# Only enable for a model and endpoint that actually support image input.
# ZEM_VIBE_VISION_ENABLED=1
