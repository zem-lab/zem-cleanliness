// =============================================================================
// 清洁度检测配置（cleanliness_detection.json）
// -----------------------------------------------------------------------------
// 用途：清洁度检测对话框（导入筛选 / 标定 / 分析）与任务编排的默认参数。
// 格式：JSONC（允许 // 与 /* */ 注释）；加载时会先去注释再解析。
// 路径：默认读取仓库 conf/ 下本文件；GUI 也可手动指定其它路径。
// =============================================================================
{
  // 配置结构版本号。当前仅支持 1；升级字段时需同步改代码里的校验。
  "schemaVersion": 1,

  // ---------------------------------------------------------------------------
  // device：电镜与 EDS 设备连接
  // ---------------------------------------------------------------------------
  "device": {
    // 电镜 JSON-RPC 主机地址（移台、成像、导航图等）
    "microscopeHost": "192.168.0.15",
    // 电镜 JSON-RPC 端口
    "microscopePort": 61557,
    // EDS gRPC 主机；通常与电镜同机，也可指向独立能谱电脑
    "edsHost": "192.168.0.15",
    // EDS gRPC 端口（默认 6200）
    "edsPort": 6200
  },

  // 经验标定文件：光镜 AB 坐标 → 样品台坐标的粗变换（相对本文件所在目录）。
  // 多颗粒法标定前用于预定位；AB 点法也会用到其中的成像参数等。
  "experienceCalibration": "optical_particle_calibration.json",

  // ---------------------------------------------------------------------------
  // abPoint：Tab2「AB 点法」导航图粗定位（实验）
  // 流程：导航图 → 夹具检测裁剪 → AB 孔检测 → 人工指定 A/B → 保存粗矩阵
  // ---------------------------------------------------------------------------
  "abPoint": {
    // ONNX 模型目录。相对路径相对于应用 ctx_dir（安装/运行资源根）。
    "modelDirectory": "models/cleanliness_ab",
    // 第一级：夹具/视野框检测模型（在导航图上框出夹具区域）
    "fixtureModel": "fixture_det_v3_best.onnx",
    // 第二级：AB 孔检测模型（在夹具裁剪图上找两个圆孔，不区分 A/B 身份）
    "holeModel": "hole_det_v3_best.onnx",
    // 推理输入边长（像素），YOLO 类模型一般为 640
    "inputSize": 640,
    // 夹具检测置信度阈值（0~1）。越高越严、框更少；过低易误检背景。
    "fixtureConfidence": 0.1,
    // AB 孔检测置信度阈值（0~1）。孔目标往往更小/更暗，通常低于夹具阈值。
    "holeConfidence": 0.1,
    // NMS 的 IoU 阈值；重叠框超过此值则抑制低分框
    "nmsIouThreshold": 0.45,
    // 夹具框外扩比例（相对框尺寸），避免孔落在裁剪边界外
    "cropMargin": 0.12,
    // 孔候选去重距离（像素）；过近的重复检出合并为一个
    "dedupDistancePx": 30.0,
    // 坐标系手性：right / left，影响 AB 点到台坐标变换的反射方向
    "handedness": "right",

    // -------------------------------------------------------------------------
    // semRefine：AB 孔 SEM 闭环圆心精定位（粗定位保存后的第二阶段）
    // 流程：移台到粗坐标 → 拍图 → 几何找圆/弧 → 追踪或扩环搜索 → 整圆确认
    // 缺省值来自 Zem20F（192.168.0.15）2026-08 真机实测
    // -------------------------------------------------------------------------
    "semRefine": {
      // 拍图倍率；100x 时视场约 1270 µm，0.9mm 孔可整圆入镜
      "magnification": 100,
      // SEM 采图分辨率（仅支持 512/1024/2048 方图）
      "imageShape": [1024, 1024],
      // Snap 像素平均次数；越大信噪比越好、拍图越慢
      "pixelAvg": 7,
      // 孔径先验（µm）。Zem20F 实测孔内缘 910 µm（标称 1 mm 量的是环带外缘）
      "holeDiameterUm": 910.0,
      // 半径先验搜索窗（±比例）
      "radiusTolerance": 0.15,
      // 扩环搜索总半径上限（µm）；所有移台目标被钳制在粗坐标该半径内
      "maxSearchRadiusUm": 2000.0,
      // 搜索步长 = 视场短边 × 该比例；<1 保证相邻视场重叠、弧不漏拍
      "searchStepRatio": 0.6,
      // 单孔拍图张数上限，超出即定位失败
      "maxCaptures": 25,
      // 矩阵验证实拍颗粒数：建矩阵后移台到这几颗光镜颗粒的预测位置实拍，
      // 供人工与光镜照片肉眼对比（空间最远点采样，用经验标定的分析倍率）
      "validationCount": 2,
      // 每次移台后的回读误差上限（µm）
      "stageErrorUm": 2.0,
      // SEM 像素轴 → 电机轴方向矩阵。Zem20F 实测像素 X 与电机 X 反向
      "pixelAxisMatrix": [
        [-1.0, 0.0],
        [0.0, 1.0]
      ],
      // 防回程差进近偏置（µm）：先到 目标+offset 再正向进入目标。
      // Zem20F 实测换向回程差 X≈85µm / Y≈17µm
      "approachOffsetUm": [-150.0, -150.0]
    }
  },

  // ---------------------------------------------------------------------------
  // calibration：Tab2「多颗粒法」SEM 三点/多组标定
  // 流程：自动/手动选锚点与验证点 → 拍 SEM → 形态匹配 → 拟合变换 → 验收
  // ---------------------------------------------------------------------------
  // AB 导航 + 颗粒精校准：纯本地 OpenCV / NumPy，不依赖 GPT 或在线分割。
  // AB 仅提供粗矩阵，不在 SEM 中寻找孔。验证点预留且冻结后独立实拍。
  // 以下误差为验收阈值，不是跨样品精度保证；修改配置后必须重新标定。
  "abParticle": {
    "coarse_magnification": 60,
    "fine_magnification": 120,
    "image_size": 1024,
    "pixel_avg": 7,
    "anchor_count": 12,
    "min_inliers": 8,
    "candidate_count": 24,
    "validation_count": 6,
    "pool_size": 160,
    "seed_attempts": 8,
    "max_search_captures": 9,
    "max_captures": 200,
    "max_seconds": 5400,
    "search_radius_um": 1800,
    "search_step_ratio": 0.55,
    "stage_error_um": 2,
    "approach_offset_um": [-150, -150],
    "axis_step_um": 150,
    "axis_min_response": 0.15,
    "axis_max_return_um": 5,
    // 光镜形状与电镜图的最低相似分数；系统设置会将用户值冻结到新任务快照。
    "match_min_score": 0.65,
    // 第一名与第二个不同位置候选的最小分差；系统设置会将用户值冻结到新任务快照。
    "match_min_margin": 0.07,
    // 单图高分种子还须通过同图邻域复核；预留验证颗粒不参与此步骤。
    "context_min_neighbors": 2,
    "context_max_neighbors": 6,
    "context_error_um": 60,
    "huber_delta_um": 30,
    // 低倍率种子仅用于进入精定位视场，不与正式锚点/最终验收混用阈值。
    "bootstrap_inlier_um": 150,
    "bootstrap_huber_delta_um": 60,
    "inlier_threshold_um": 75,
    "min_inlier_fraction": 0.7,
    "min_coverage": 0.25,
    "max_linear_change": 0.15,
    "mean_error_um": 30,
    "max_error_um": 60
  },

  "calibration": {
    // 坐标变换模型：
    //   similarity            — 相似变换（旋转+缩放+平移，无反射）
    //   reflected_similarity  — 反射相似变换（常见：光镜与 SEM 镜像）
    //   auto_similarity       — 自动在以上两种中选残差更小者
    //   affine                — 仿射（自由度更高，需更多点）
    "model": "reflected_similarity",
    // 自动生成的标定组数（每组独立锚点+验证点，供用户对比择优）
    "groupCount": 3,
    // 每组锚点颗粒数（拟合变换用，通常 3）
    "anchorCount": 3,
    // 每组独立验证颗粒数（不参与拟合，用于评估外推误差）
    "validationCount": 2,
    // 从筛选结果中抽取锚点候选池的上限，再从中组三角形
    "anchorPoolSize": 30,
    // 每个锚点 SEM 图上最多保留的颗粒候选数（供形状匹配）
    "semCandidatesPerAnchor": 6,
    // SEM 颗粒候选补充分割：backend 可设为 "yolo"、"sam3" 或 "classic"。
    // 无论选择哪种模式，原有 OpenCV 几何检测都会保留。
    "candidateSegmentation": {
      "backend": "yolo",
      "modelPath": "../models/cleanliness/particle_yolo11n_seg_reann_20260811_best.onnx",
      "inputSize": 1024,
      "confidenceThreshold": 0.25,
      "iouThreshold": 0.45,
      "maskThreshold": 0.5,
      "maxDetections": 100,
      "sam3Url": "http://192.168.0.207:8765"
    },
    // 匹配评分中残差项的尺度（µm）；越大则对残差越宽容
    "residualScaleUm": 60.0,

    // SEM 候选相对光镜颗粒的门控：比值/信号不过关则直接丢弃
    "candidateGate": {
      // 长度比下限/上限（SEM 候选长 ÷ 光镜长）
      "minLengthRatio": 0.35,
      "maxLengthRatio": 2.8,
      // 宽度比下限/上限
      "minWidthRatio": 0.18,
      "maxWidthRatio": 4.5,
      // 面积比下限/上限
      "minAreaRatio": 0.12,
      "maxAreaRatio": 8.0,
      // 候选相对背景的最小信号强度（Z 分数类指标）
      "minSignalZ": 1.6,
      // 轮廓最小面积（像素），过滤噪声碎块
      "minContourAreaPx": 30.0
    },

    // SEM 像素轴到台坐标轴的方向矩阵（单位基）。
    // 默认单位阵；若成像坐标系相对台坐标有翻转/对调再改。
    "pixelAxisMatrix": [
      [1.0, 0.0],
      [0.0, 1.0]
    ],

    // 验证集误差验收阈值（µm）。均值与最大值都需满足才判通过。
    "acceptance": {
      "meanErrorUm": 80.0,
      "maxErrorUm": 160.0
    }
  },

  // ---------------------------------------------------------------------------
  // task：分析任务运行策略（Tab3 及标定过程中的设备行为）
  // ---------------------------------------------------------------------------
  "task": {
    // 「快速模式」最多分析的颗粒数（联调/抽检用）
    "quickMaxParticles": 3,
    // 任务结束后是否回到开始时的台位置
    "restoreStartPosition": true,
    // 任务开始时是否自动开枪（HV）
    "gunOnAtStart": true,
    // 任务结束后是否自动关枪
    "gunOffAfterTask": true,
    // 是否做 EDS 能谱采集（关闭则只定位/成像）
    "edsEnabled": true,
    // 光镜形状与电镜实测轮廓的最低重叠；系统设置会将用户值冻结到新任务快照。
    "contourOverlapMin": 0.5,
    // 每个颗粒最多拍几张。第一张匹配通过就不再拍；系统设置会冻结到新任务快照。
    "maxCaptureAttempts": 2,
    // 超视场，或接近视场且实拍被边缘截断的大颗粒，在中心附近找内部采谱点
    "largeParticleCenterSampling": {
      "enabled": true,
      "allowClippedNearField": true,
      "minimumLengthToFieldWidth": 1.0,
      "centerRegionRadiusFraction": 0.05,
      // 90% 覆盖率用于实际采谱点的小邻域；整个中心搜索框覆盖率只作记录
      "minimumCenterCoverage": 0.90,
      "minimumIntensitySeparation": 20.0,
      "minimumPointClearancePx": 3.0
    },
    // 单次 EDS 等待超时（秒）
    "edsTimeoutSeconds": 60.0
  },

  // ---------------------------------------------------------------------------
  // report：清洁度报告（HTML / PDF / CSV）展示选项
  // ---------------------------------------------------------------------------
  "report": {
    "showCoordinates": true,
    // 报告标题
    "title": "清洁度检测报告",
    // 每个颗粒按含量占比最多展示几个主元素；不足则留空列
    "elementColumns": 5,
    // 报告中排除的元素符号（常见基体/污染元素，如 O、C）
    "excludeElements": ["O", "C"]
  }
}
